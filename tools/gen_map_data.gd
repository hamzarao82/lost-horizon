extends SceneTree
## Writes resources/regions/maps/dead_coast.tres and blackwood.tres from the builders' own area tables, so
## the world map shows the real layouts. Prints the region bounds to use as RegionData.map_extents.
## Run: godot --headless --path . -s tools/gen_map_data.gd   (tests/map_check.gd fails when the files drift)

const OUT_DIR: String = "res://resources/regions/maps/"
const MARGIN: float = 12.0


func _initialize() -> void:
	_write_dead_coast()
	_write_blackwood()
	quit()


func _lm(region: StringName, id: String, label: String, rect: Rect2, first: bool) -> String:
	var flag := "" if first else String(MapData.discovery_flag(region, StringName(id)))
	return '{"id": "%s", "name": "%s", "rect": Rect2(%.2f, %.2f, %.2f, %.2f), "kind": "area", "flag": "%s"}' % [
			id, label.replace('"', "'"), rect.position.x, rect.position.y, rect.size.x, rect.size.y, flag]


func _exit(pos: Vector2, target: String) -> String:
	return '{"pos": Vector2(%.2f, %.2f), "target": "%s"}' % [pos.x, pos.y, target]


func _save(region: String, overview: Vector2, hint: String, note: String, landmarks: Array[String], exits: Array[String]) -> void:
	var text := '[gd_resource type="Resource" script_class="MapData" load_steps=2 format=3]\n\n'
	text += '[ext_resource type="Script" path="res://scripts/regions/map_data.gd" id="1_map"]\n\n[resource]\n'
	text += 'script = ExtResource("1_map")\nregion_id = &"%s"\noverview_pos = Vector2(%.2f, %.2f)\nunlock_hint = "%s"\n' % [region, overview.x, overview.y, hint]
	text += "; %s\n" % note
	text += "landmarks = [\n" + ",\n".join(landmarks) + "\n]\n"
	text += "exits = [\n" + ",\n".join(exits) + "\n]\n"
	var file := FileAccess.open("%s%s.tres" % [OUT_DIR, region], FileAccess.WRITE)
	file.store_string(text)
	file.close()
	print("wrote ", region, " (", landmarks.size(), " landmarks, ", exits.size(), " exits)")


func _write_dead_coast() -> void:
	var builder := DeadCoast.new()
	var landmarks: Array[String] = []
	var bounds := Rect2()
	for i in DeadCoast.AREAS.size():
		var area: Dictionary = DeadCoast.AREAS[i]
		var rect := builder._area_rect(area)
		bounds = rect if i == 0 else bounds.merge(rect)
		landmarks.append(_lm(&"dead_coast", String(area["id"]), String(area["name"]), rect, i == 0))
	var to_outpost := DeadCoastTerrain.ground(14.0, 24.0)
	var to_blackwood := DeadCoastTerrain.ground(18.0, -224.0)
	var exits: Array[String] = [
		_exit(Vector2(to_outpost.x, to_outpost.z), "outpost_17"),
		_exit(Vector2(to_blackwood.x, to_blackwood.z), "blackwood"),
	]
	bounds = bounds.merge(Rect2(to_outpost.x, to_outpost.z, 0.0, 0.0)).merge(Rect2(to_blackwood.x, to_blackwood.z, 0.0, 0.0)).grow(MARGIN)
	_save("dead_coast", Vector2(0.16, 0.3), "Complete The First Signal at Outpost 17",
			"Generated by tools/gen_map_data.gd from DeadCoast.AREAS; do not edit by hand.", landmarks, exits)
	print("dead_coast map_extents = Rect2(%.1f, %.1f, %.1f, %.1f)" % [bounds.position.x, bounds.position.y, bounds.size.x, bounds.size.y])
	builder.free()


func _write_blackwood() -> void:
	var landmarks: Array[String] = []
	for i in Blackwood.AREAS.size():
		var area: Dictionary = Blackwood.AREAS[i]
		landmarks.append(_lm(&"blackwood", String(area["area"]), String(area["label"]), Blackwood.area_rect(area), i == 0))
	var exits: Array[String] = [
		_exit(Vector2(0.0, 18.0), "dead_coast"),
		_exit(Vector2(-10.0, -266.0), "research_complex"),
	]
	_save("blackwood", Vector2(0.55, 0.3), "Finish Dead Coast: Lost Cargo",
			"Generated by tools/gen_map_data.gd from Blackwood.AREAS; do not edit by hand.", landmarks, exits)
	var b := Blackwood.BOUNDS
	print("blackwood map_extents = Rect2(%.1f, %.1f, %.1f, %.1f)" % [b.position.x, b.position.y, b.size.x, b.size.y])
