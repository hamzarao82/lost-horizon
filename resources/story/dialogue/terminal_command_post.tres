[ext_resource type="Script" path="res://scripts/story/dialogue_sequence.gd" id="2_l7cod"]

[sub_resource type="Resource" id="Resource_o5d5l"]
script = ExtResource("1_73txx")
speaker = "Terminal"
text = "Session restored. The last operator never closed the channel."

[sub_resource type="Resource" id="Resource_mftvy"]
script = ExtResource("1_73txx")
speaker = "You"
text = "Whoever sat here left in a hurry."
seconds = 3.0

[sub_resource type="Resource" id="Resource_fearm"]
script = ExtResource("1_73txx")
speaker = "Radio"
text = "Take what the screen gives you. Do not stay in one place."

[resource]
