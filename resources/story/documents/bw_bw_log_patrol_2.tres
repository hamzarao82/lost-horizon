[ext_resource type="Script" path="res://scripts/story/document_data.gd" id="1_dhjuv"]

[resource]
script = ExtResource("1_dhjuv")
key = &"bw_bw_log_patrol_2"
source_id = &"bw_log_patrol_2"
title = "Torn page"
region = &"blackwood"
body = "Somebody cut our line on purpose. Private Okoro says the animals went quiet before the first shot was fired. We are leaving the camp as it is and going on foot to the perimeter. If you find this, do not take the main gate."
order = 1
