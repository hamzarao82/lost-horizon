[ext_resource type="Script" path="res://scripts/story/document_data.gd" id="1_u7qed"]

[resource]
script = ExtResource("1_u7qed")
key = &"if_if_lockdown_relay"
source_id = &"if_lockdown_relay"
title = "Lockdown relay"
region = &"iron_fortress"
body = "INNER LOCKDOWN, stage one of three. Relay in the barracks block.
Stage one released: the barracks doors no longer hold the command door shut. The remaining stages are inside the walls.
The relay was meant to be turned off by hand, here, by someone who still believed in the drill."
order = 10
