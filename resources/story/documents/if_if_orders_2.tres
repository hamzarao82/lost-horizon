title = "Classified order 23"
category = &"classified"
region = &"iron_fortress"
body = "ORDER 23. The containment sector is to be tested under field conditions. Cell locks are to be released on signal.
Staff in the sector are to be informed that it is a drill.
Authorized: the Director. Witness: none."
order = 4
