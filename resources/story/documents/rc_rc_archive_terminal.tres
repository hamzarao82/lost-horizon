[ext_resource type="Script" path="res://scripts/story/document_data.gd" id="1_gjfqc"]

[resource]
script = ExtResource("1_gjfqc")
key = &"rc_rc_archive_terminal"
source_id = &"rc_archive_terminal"
title = "Research archive"
category = &"research_record"
region = &"research_complex"
body = "CLASSIFIED: SECTION INDEX. A to C: logistics and transfers. D: medical trials. E: containment protocols. F: Project Black Site.
Trial summaries list 'subjects' by number, 1 to 31. Column four reads: consent, none recorded.
Every transfer slip ends with the same line: to be completed at the command, not here. This facility was never the whole of it."
order = 14
