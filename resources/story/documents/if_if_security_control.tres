[gd_resource type="Resource" script_class="DocumentData" format=3]

[ext_resource type="Script" path="res://scripts/story/document_data.gd" id="1_vdvmd"]

[resource]
script = ExtResource("1_vdvmd")
key = &"if_if_security_control"
source_id = &"if_security_control"
title = "Perimeter security control"
region = &"iron_fortress"
body = "PERIMETER CONTROL. Gate actuators: ARMED. Tower feeds: 9 of 12. Barracks gate: LOCKED.
The gate activation sequence is complete. Barracks access now answers to the control panel in this room.
Operator note: the lockdown was written to cascade inward. Each door that opens tells the next one."
order = 8
