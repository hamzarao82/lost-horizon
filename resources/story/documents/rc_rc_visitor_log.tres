[ext_resource type="Script" path="res://scripts/story/document_data.gd" id="1_axdbb"]

[resource]
script = ExtResource("1_axdbb")
key = &"rc_rc_visitor_log"
source_id = &"rc_visitor_log"
title = "Reception visitor log"
region = &"research_complex"
body = "Visitors are logged by badge number only. Names are not recorded.
Eleven badges signed in on the last day. One signed out.
A note clipped to the page: do not let the medical staff leave through the front. Use the lower corridor."
