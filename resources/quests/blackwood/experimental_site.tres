reward_text = "Credits, a weapon upgrade kit and the Ghost Charm."
start_captions = PackedStringArray("Fresh tire tracks. Somebody still drives to the testing site.")
complete_captions = PackedStringArray("The research facility is open. Whatever they did here, it started below.")
location_hint = "Experimental site"
