[resource]
script = ExtResource("2_6ug7p")
id = &"experimental_site"
title = "The Experimental Site"
description = "The recovered data points to a testing site behind the research perimeter. Get in, find out what they did there and open the way on."
objectives = Array[ExtResource("1_tp1x0")]([SubResource("Resource_ov1ue"), SubResource("Resource_gkxh8"), SubResource("Resource_u4q0n"), SubResource("Resource_bpmqd"), SubResource("Resource_bnymt"), SubResource("Resource_28nso"), SubResource("Resource_wrdix"), SubResource("Resource_6a4m3"), SubResource("Resource_rgs35")])
