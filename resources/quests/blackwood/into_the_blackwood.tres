[resource]
script = ExtResource("2_wuwxo")
id = &"into_the_blackwood"
title = "Into the Blackwood"
description = "The coast trail ends at a wall of jungle. A military track leads in. Follow it and find out what happened to the patrol that took it."
objectives = Array[ExtResource("1_eel55")]([SubResource("Resource_cqkwb"), SubResource("Resource_rpvvs"), SubResource("Resource_6omu8"), SubResource("Resource_hc4pw"), SubResource("Resource_n4pwp"), SubResource("Resource_dlva3")])
rewards = PackedStringArray("credits_medium", "bandage", "bandage")
reward_text = "Credits and field dressings."
next_quest = &"ghost_frequency"
start_captions = PackedStringArray("The trail goes in. The patrol never came out.")
complete_captions = PackedStringArray("A hand-drawn map in the camp marks a signal tower deeper in.")
location_hint = "Blackwood"
