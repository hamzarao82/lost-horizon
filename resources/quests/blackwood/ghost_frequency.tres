[resource]
script = ExtResource("2_kxwe3")
id = &"ghost_frequency"
title = "Ghost Frequency"
description = "A transmitter is still sending from somewhere in the trees. Tune the hidden station and listen."
objectives = Array[ExtResource("1_tvsyj")]([SubResource("Resource_kkctu"), SubResource("Resource_jm0lb"), SubResource("Resource_askpc"), SubResource("Resource_50py6"), SubResource("Resource_tncf4"), SubResource("Resource_rntt0"), SubResource("Resource_71x64")])
rewards = PackedStringArray("credits_medium", "armor_plate", "electronics")
reward_text = "Credits, an armor plate and electronics."
next_quest = &"experimental_site"
start_captions = PackedStringArray("Static, then a voice counting numbers. Find where it comes from.")
complete_captions = PackedStringArray("Black Site. The same name as the file in Outpost 17.")
location_hint = "Hidden station"
