[resource]
script = ExtResource("2_ahhng")
id = &"if_black_site"
title = "Black Site"
description = "Read the final records, face the Director and end the operation."
objectives = Array[ExtResource("1_6stl4")]([SubResource("Resource_awtsd"), SubResource("Resource_7l717"), SubResource("Resource_fqxqy"), SubResource("Resource_nml6f"), SubResource("Resource_7kwg2"), SubResource("Resource_saxk8")])
rewards = PackedStringArray("credits_medium", "health_potion")
reward_text = "Credits and a medkit. The campaign is complete."
start_captions = PackedStringArray("Clean floors, quiet screens. The place where every order ended.")
complete_captions = PackedStringArray("The operation is over. The island is quiet.")
location_hint = "Control facility"
