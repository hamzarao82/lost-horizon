[resource]
script = ExtResource("2_ynlv5")
id = &"if_last_stronghold"
title = "The Last Stronghold"
description = "The route table ends at one place: a walled command inland, behind an iron gate. Get to the checkpoint, find a way past the guards and open the main gate."
objectives = Array[ExtResource("1_p4fsc")]([SubResource("Resource_2h3k4"), SubResource("Resource_4jo0w"), SubResource("Resource_lqqyg"), SubResource("Resource_ed02w"), SubResource("Resource_sl3aj"), SubResource("Resource_iaiga"), SubResource("Resource_2sc7m")])
rewards = PackedStringArray("credits_medium", "bandage", "armor_patch")
reward_text = "Credits, a bandage and an armor patch."
next_quest = &"if_inside_the_walls"
start_captions = PackedStringArray("Walls, towers and one iron gate. Everything on this island was ordered from here.")
complete_captions = PackedStringArray("The main gate grinds open. Nobody inside has been expecting a visitor.")
location_hint = "Fortress approach"
