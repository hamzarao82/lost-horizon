[resource]
script = ExtResource("2_1ray0")
id = &"if_chain_of_command"
title = "Chain of Command"
description = "Take the command center. Bring the communications network back, read the files and learn who gave the orders."
objectives = Array[ExtResource("1_olkg0")]([SubResource("Resource_2ewwd"), SubResource("Resource_4671m"), SubResource("Resource_et7mc"), SubResource("Resource_l5qd5"), SubResource("Resource_sroag"), SubResource("Resource_cik1q"), SubResource("Resource_r6jnc"), SubResource("Resource_m8mso")])
rewards = PackedStringArray("credits_medium", "antiseptic", "bandage")
reward_text = "Credits, antiseptic and a bandage."
next_quest = &"if_final_lockdown"
start_captions = PackedStringArray("Screens, maps and a long table. The people who ran the island worked here.")
complete_captions = PackedStringArray("Now there is a name on the other end of every order. The inner fortress is open.")
location_hint = "Command center"
