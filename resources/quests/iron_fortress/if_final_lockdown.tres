[resource]
script = ExtResource("2_yrxsl")
id = &"if_final_lockdown"
title = "The Final Lockdown"
description = "The inner fortress holds the way to Control. Break its defenders, lift the lockdown at all three points and bring down the Captain."
objectives = Array[ExtResource("1_7dmrd")]([SubResource("Resource_4st3q"), SubResource("Resource_d5jfl"), SubResource("Resource_cvw26"), SubResource("Resource_ekkhj"), SubResource("Resource_b8qt6"), SubResource("Resource_ocgys")])
rewards = PackedStringArray("credits_medium", "armor_plate", "health_potion")
reward_text = "Credits, an armor plate and a medkit."
next_quest = &"if_black_site"
start_captions = PackedStringArray("Red lamps, narrow halls and a door that does not open from this side.")
complete_captions = PackedStringArray("The control door is open. Whatever the Director built, it is down there.")
location_hint = "Inner fortress"
