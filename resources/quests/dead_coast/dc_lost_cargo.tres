[resource]
script = ExtResource("2_3nwrq")
id = &"dc_lost_cargo"
title = "Lost Cargo"
description = "The shipment never reached Outpost 17. Follow it to Smuggler's Cove."
prerequisites = PackedStringArray("dc_silent_checkpoint")
objectives = Array[ExtResource("1_pw6ra")]([SubResource("Resource_dbanm"), SubResource("Resource_e8msw"), SubResource("Resource_giky3"), SubResource("Resource_o40wg"), SubResource("Resource_5nx5a"), SubResource("Resource_eoxeb"), SubResource("Resource_6kch5"), SubResource("Resource_ppkch")])
rewards = PackedStringArray("coastal_weapon_part", "credits_medium")
reward_text = "Coastal weapon part and credits"
start_captions = PackedStringArray("The cargo left the beach in sealed crates. Find where they were hidden.")
complete_captions = PackedStringArray("Lost Cargo: complete.", "The trail goes on into the Blackwood. The way north is open.")
caption_seconds = 4.5
location_hint = "Smuggler's Cove"
