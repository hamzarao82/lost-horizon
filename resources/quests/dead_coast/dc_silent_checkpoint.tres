[resource]
script = ExtResource("2_6w55u")
id = &"dc_silent_checkpoint"
title = "The Silent Checkpoint"
description = "A military checkpoint on the coast road stopped answering. Find out why, and open the supply route."
prerequisites = PackedStringArray("dc_wreckage")
objectives = Array[ExtResource("1_qglf7")]([SubResource("Resource_pltku"), SubResource("Resource_pxftn"), SubResource("Resource_1xohk"), SubResource("Resource_we5y4"), SubResource("Resource_u18w5"), SubResource("Resource_yxraa")])
rewards = PackedStringArray("armor_patch", "credits_medium")
reward_text = "Armor patch and credits"
next_quest = &"dc_lost_cargo"
start_captions = PackedStringArray("The checkpoint is a dead end for the radio. Somebody ordered it left empty.")
complete_captions = PackedStringArray("The Silent Checkpoint: complete.", "The supply route is open. The cargo went north.")
caption_seconds = 4.5
location_hint = "Abandoned Checkpoint"
