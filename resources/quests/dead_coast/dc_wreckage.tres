[resource]
script = ExtResource("2_p3wyp")
id = &"dc_wreckage"
title = "Wreckage"
description = "A freighter broke apart on the Dead Coast. Somebody was moving something the military did not want seen."
objectives = Array[ExtResource("1_pewld")]([SubResource("Resource_h7dec"), SubResource("Resource_06vip"), SubResource("Resource_wyoud"), SubResource("Resource_kneqw"), SubResource("Resource_p508b"), SubResource("Resource_oiwf8"), SubResource("Resource_epphx")])
rewards = PackedStringArray("upgrade_kit_weapon", "credits_medium")
reward_text = "Weapon Upgrade Kit and credits"
next_quest = &"dc_silent_checkpoint"
start_captions = PackedStringArray("The coast is quiet. Too quiet. The wreck is the only thing out here that is still talking.")
complete_captions = PackedStringArray("Wreckage: complete.", "Someone staged this crash. The data device points up the coast.")
caption_seconds = 4.5
location_hint = "Wreckage Beach"
