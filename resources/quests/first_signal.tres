[resource]
script = ExtResource("1_quest")
id = &"first_signal"
title = "The First Signal"
description = "A weak military transmission is coming from Outpost 17. Find out who is sending it, and what they are hiding."
prerequisites = PackedStringArray()
objectives = Array[ExtResource("2_obj")]([SubResource("O1"), SubResource("O2"), SubResource("O3"), SubResource("O4"), SubResource("O5"), SubResource("O6"), SubResource("O7"), SubResource("O8"), SubResource("O9"), SubResource("OPT")])
