[resource]
script = ExtResource("1_quest")
id = &"first_signal"
title = "The First Signal"
description = "A weak military transmission is coming from Outpost 17. Find out who is sending it, and what they are hiding."
prerequisites = PackedStringArray()
objectives = Array[ExtResource("2_obj")]([SubResource("O1"), SubResource("O2"), SubResource("O3"), SubResource("O4"), SubResource("O5"), SubResource("O6"), SubResource("O7"), SubResource("O8"), SubResource("O9"), SubResource("OPT"), SubResource("N1"), SubResource("N2"), SubResource("N3"), SubResource("N4"), SubResource("N5"), SubResource("N6")])
rewards = PackedStringArray("combat_knife")
reward_text = "Combat Knife"
next_quest = &"restore_power"
start_captions = PackedStringArray("...static... Can anyone hear this? If you can hear this, you are not alone.", "A weak signal is coming from Outpost 17. Find the source.")
complete_captions = PackedStringArray("Signal confirmed. They know you're alive now. Move.", "The First Signal: complete.")
caption_seconds = 4.5
category = 0
location_hint = "Outer Perimeter"
show_mission_banner = true
