[resource]
script = ExtResource("2_vyu6j")
id = &"rc_restricted_zone"
title = "The Restricted Zone"
description = "The route table from the experimental site ends at a fenced facility in the north of the Blackwood. Get through its perimeter and into the administration wing."
objectives = Array[ExtResource("1_saeku")]([SubResource("Resource_majbv"), SubResource("Resource_sgo8l"), SubResource("Resource_cqer6"), SubResource("Resource_dpx3i"), SubResource("Resource_c6aqy"), SubResource("Resource_k2pne")])
rewards = PackedStringArray("credits_medium", "bandage", "armor_patch")
reward_text = "Credits, a bandage and an armor patch."
next_quest = &"rc_silent_records"
start_captions = PackedStringArray("A fence, a hut and a door that has not been opened in weeks.")
complete_captions = PackedStringArray("The administration wing is open. It smells of old paper and dust.")
location_hint = "Research perimeter"
