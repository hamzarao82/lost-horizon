class_name StoryEnding
extends CanvasLayer
## End of the slice: "Thanks for playing", credits, Play Again / Quit. Pauses the game while shown.

const CREDITS: Array[String] = [
	"Lost Horizon: Black Site",
	"Design and code: Hamza Rao",
	"Built with Godot 4 and Claude Code",
	"All sound effects and music are generated by script",
]

var _play_again: Button
var _was_paused: bool = false


func _ready() -> void:
	layer = 160
	process_mode = Node.PROCESS_MODE_ALWAYS
	_was_paused = get_tree().paused
	get_tree().paused = true
	_build_ui()
	_play_again.grab_focus.call_deferred()


func _build_ui() -> void:
	var dim := ColorRect.new()
	dim.color = Color(0.0, 0.0, 0.0, 0.88)
	dim.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(dim)

	var center := CenterContainer.new()
	center.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(center)
	var box := VBoxContainer.new()
	box.add_theme_constant_override("separation", 14)
	center.add_child(box)

	box.add_child(_label("THANKS FOR PLAYING", 48, Color(0.95, 0.85, 0.5)))
	box.add_child(_label("The transmission is out. The story continues...", 22, Color.WHITE))
	box.add_child(Control.new())
	for line in CREDITS:
		box.add_child(_label(line, 18, Color(0.75, 0.75, 0.8)))
	box.add_child(Control.new())

	_play_again = _button("Play Again", _on_play_again)
	box.add_child(_play_again)
	if not (OS.has_feature("web") or TouchControls.is_mobile_platform()):
		box.add_child(_button("Quit", _on_quit))


func _label(text: String, font_size: int, color: Color) -> Label:
	var label := Label.new()
	label.text = text
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.add_theme_font_size_override("font_size", font_size)
	label.add_theme_color_override("font_color", color)
	return label


func _button(text: String, handler: Callable) -> Button:
	var button := Button.new()
	button.text = text
	button.custom_minimum_size = Vector2(280, 56)
	button.add_theme_font_size_override("font_size", 24)
	button.pressed.connect(handler)
	return button


func _on_play_again() -> void:
	get_tree().paused = false
	var save_manager := get_node_or_null("/root/SaveManager")
	if save_manager:
		save_manager.reset_runtime_state()  # also restarts the quest line and the world flags
	else:
		var quests := get_node_or_null("/root/QuestManager")
		if quests:
			quests.reset()
	get_tree().reload_current_scene()
	queue_free()


func _on_quit() -> void:
	get_tree().quit()


func _exit_tree() -> void:
	if get_tree() != null:
		get_tree().paused = _was_paused
