class_name Director
extends Enemy
## The Director, final boss of the Iron Fortress (Milestone 9), and the Fortress Captain mini-boss: one
## class, two profiles. Built on the Warden pattern (telegraph, strike, recovery; super armor; invulnerable
## transitions; defeat sequence) and the ranged framework (pooled Projectiles).
##
## Phases (profile "director"; the captain stays in phase 1 with its own move set):
##   1 TACTICAL    100% to 60%: aimed bursts and a sweeping line from a controlled distance band, a close counter.
##   2 AGGRESSIVE  60% to 25%:  faster, volley then dash combos, shorter gaps (never below the recovery window).
##   3 FINAL STAND below 25%:   wide telegraphed rings and a crossing barrage, each followed by a long opening.
## Every move is telegraph -> strike -> recovery with the frame data in resources/attacks (generated by
## tools/gen_director_data.gd) so tests assert fairness from data. A phase change makes him invulnerable for
## TRANSITION_TIME, spawns a harmless ring, says a line, and gives GRACE_AFTER_TRANSITION seconds before the
## next attack: no back-to-back damage.

signal defeated_director
signal phase_changed(phase: int)

const PROFILE_DIRECTOR: StringName = &"director"
const PROFILE_CAPTAIN: StringName = &"captain"
const DEFEATED_FLAG: StringName = &"iron_fortress_director_defeated"
const CAPTAIN_FLAG: StringName = &"iron_fortress_captain_defeated"
const ATTACK_DIR: String = "res://resources/attacks/"

const PHASE2_THRESHOLD: float = 0.6
const PHASE3_THRESHOLD: float = 0.25
const TRANSITION_TIME: float = 2.0
const GRACE_AFTER_TRANSITION: float = 2.0
const INTERRUPT_STAGGER: float = 0.5

const BAND_MIN: float = 6.0
const BAND_MAX: float = 12.0
const FINAL_BAND_MIN: float = 3.5  # the final stand closes in: rings only threaten what is close
const FINAL_BAND_MAX: float = 7.0
const CLOSE_RANGE: float = 3.0
const COUNTER_COOLDOWN: float = 4.5
const STRAFE_FLIP_SECONDS: float = 2.2
const COVER_REPATH: float = 1.5
const SHOT_SPEED: float = 18.0
const SHOT_SPACING: float = 0.3
const AIM_LOCK: float = 0.7  # fraction of the telegraph after which the aim is committed
const SWEEP_SHOTS: int = 5
const SWEEP_ARC: float = 56.0
const SWEEP_TIME: float = 0.8
const BARRAGE_PER_WAVE: int = 4
const DASH_SPEED: float = 16.0
const DASH_MAX: float = 9.0
const DASH_HIT_RADIUS: float = 1.6
const RING_RADIUS: float = 6.0
const RING_TIME: float = 0.6
const RING_BAND: float = 0.9
const CAPTAIN_SLAM_RADIUS: float = 4.5
const SLOWMO_SECONDS: float = 0.5
const MOVE_FILES: Dictionary = {
	&"volley": "director_volley", &"sweep": "director_sweep", &"counter": "director_counter",
	&"dash": "director_dash", &"ring": "director_ring", &"barrage": "director_barrage",
}
const CAPTAIN_MOVE_FILES: Dictionary = {
	&"volley": "fortress_captain_volley", &"dash": "fortress_captain_charge", &"ring": "fortress_captain_slam",
	&"counter": "fortress_shove",
}
const PHASE_COLORS: Array[Color] = [Color(0.12, 0.12, 0.16), Color(0.32, 0.12, 0.14), Color(0.62, 0.1, 0.08)]
const LINES: Dictionary = {
	2: "You were never meant to find this place.",
	3: "Every record burns. Every witness is a loose end. You are the last one.",
}
const DEFEAT_LINE: String = "The Director falls."

@export var profile: StringName = PROFILE_DIRECTOR

var phase: int = 1
var forced_attack: StringName = &""
var stats: Dictionary = {"phase_changes": 0, "volleys": 0, "sweeps": 0, "dashes": 0, "rings": 0,
		"barrages": 0, "counters": 0, "shots": 0}
var projectile_cap_hits: int = 0

var _moves: Dictionary = {}
var _kind: StringName = &""
var _planned: StringName = &""
var _sp_phase: int = 0  # 0 telegraph, 1 strike, 2 recovery
var _sp_timer: float = 0.0
var _sp_frames: float = 0.0
var _fired: int = 0
var _shot_clock: float = 0.0
var _aim_dir: Vector3 = Vector3.FORWARD
var _locked_target: Vector3 = Vector3.ZERO
var _dash_dir: Vector3 = Vector3.FORWARD
var _dash_start: Vector3 = Vector3.ZERO
var _special_hit_done: bool = false
var _counter_cd: float = 0.0
var _strafe_dir: float = 1.0
var _strafe_time: float = 0.0
var _cover_clock: float = 0.0
var _cover_target: Variant = null
var _transitioning: bool = false
var _transition_time: float = 0.0
var _last_kind: StringName = &""
var _rings: Array[Dictionary] = []
var _marker: MeshInstance3D
var _shots: Array[Projectile] = []
var _defeat_done: bool = false


func _ready() -> void:
	super()
	add_to_group("boss")
	_uncount()  # the boss must not shrink the soldiers' attack-token limit
	var files: Dictionary = MOVE_FILES if profile == PROFILE_DIRECTOR else CAPTAIN_MOVE_FILES
	for kind in files:
		_moves[kind] = load(ATTACK_DIR + String(files[kind]) + ".tres") as AttackData
	_swing = _moves[&"counter"]
	var collider := $CollisionShape3D as CollisionShape3D
	var capsule := (collider.shape as CapsuleShape3D).duplicate() as CapsuleShape3D
	capsule.radius = 0.4 * body_scale * 0.8
	capsule.height = 1.8 * body_scale
	collider.shape = capsule
	collider.position.y = capsule.height * 0.5
	_label.position.y = capsule.height + 0.6
	_cooldown = 1.2


func is_boss() -> bool:
	return true


func attack_data(kind: StringName) -> AttackData:
	return _moves.get(kind) as AttackData


func moves_for_phase(p: int) -> Array[StringName]:
	if profile == PROFILE_CAPTAIN:
		return [&"volley", &"dash", &"ring"]
	match p:
		1:
			return [&"volley", &"sweep"]
		2:
			return [&"volley", &"sweep", &"dash"]
		_:
			return [&"ring", &"barrage", &"dash", &"volley"]


func is_transitioning() -> bool:
	return _transitioning


func _physics_process(delta: float) -> void:
	_counter_cd = maxf(_counter_cd - delta, 0.0)
	_update_rings(delta)
	if _transitioning:
		_update_transition(delta)
	super(delta)


# --- chase: controlled movement, attack choice -------------------------------

func _state_chase(delta: float) -> void:
	var player := _target()
	if player == null:
		state = State.IDLE
		return
	var to := _flat_to(player)
	var dist := to.length()
	var dir := to.normalized()
	_face(dir, delta)
	if _cooldown <= 0.0 and not _transitioning:
		if _planned == &"":
			_planned = _pick_attack(dist)
		_start_attack()
		return
	_reposition(dir, dist, delta)


## Keep a distance band, using cover points when the level has them, strafing otherwise.
func _reposition(dir: Vector3, dist: float, delta: float) -> void:
	var speed := move_speed * (1.0 + 0.12 * float(phase - 1))
	var band_min := BAND_MIN if phase < 3 else FINAL_BAND_MIN
	var band_max := BAND_MAX if phase < 3 else FINAL_BAND_MAX
	if dist < band_min:
		_move_horizontal(-dir, speed)
		return
	if dist > band_max:
		_move_horizontal(dir, speed)
		return
	_cover_clock -= delta
	if _cover_clock <= 0.0:
		_cover_clock = COVER_REPATH
		var player := _target()
		if player != null:
			_cover_target = CoverPoint.best_for(get_tree(), get_world_3d(), global_position, player.global_position, band_min, band_max)
	if _cover_target != null:
		var goal := _cover_target as Vector3
		var to_goal := goal - global_position
		to_goal.y = 0.0
		if to_goal.length() > 1.0:
			_move_horizontal(to_goal.normalized(), speed * 0.8)
			return
	_strafe_time -= delta
	if _strafe_time <= 0.0:
		_strafe_time = STRAFE_FLIP_SECONDS
		_strafe_dir = -_strafe_dir
	var side := Vector3(-dir.z, 0.0, dir.x) * _strafe_dir
	_move_horizontal(side, speed * 0.6)


## Weighted pick with two learnability rules: never the same move twice in a row, and the close counter
## is used only when the player is inside CLOSE_RANGE and it is off cooldown.
func _pick_attack(dist: float) -> StringName:
	if forced_attack != &"":
		return forced_attack
	if dist <= CLOSE_RANGE and _counter_cd <= 0.0:
		return &"counter"
	var options := moves_for_phase(phase)
	var weights: Array[float] = []
	for kind in options:
		var w := 1.0
		match kind:
			&"volley":
				w = 3.0
			&"sweep":
				w = 2.0
			&"dash":
				w = 2.0 if dist >= 4.0 else 0.0
			&"ring":
				w = 3.0 if dist <= _ring_radius() + 1.0 else 0.0
			&"barrage":
				w = 3.0
		if kind == _last_kind:
			w = 0.0
		weights.append(w)
	var total := 0.0
	for w in weights:
		total += w
	if total <= 0.0:
		return options[0]
	var roll := randf() * total
	for i in options.size():
		roll -= weights[i]
		if roll <= 0.0 and weights[i] > 0.0:
			return options[i]
	return options[0]


func _start_attack() -> void:
	_kind = _planned
	_planned = &""
	_last_kind = _kind
	_sp_phase = 0
	_sp_timer = 0.0
	_sp_frames = 0.0
	_fired = 0
	_shot_clock = 0.0
	_special_hit_done = false
	var player := _target()
	if player != null:
		_aim_dir = _flat_to(player).normalized()
		_locked_target = player.global_position
	_swing = attack_data(_kind)
	if _kind == &"counter":
		_counter_cd = COUNTER_COOLDOWN
		stats["counters"] += 1
	super()


func _state_attack(delta: float) -> void:
	if _kind == &"counter":
		super(delta)  # a plain melee swing through the Enemy hitbox
		return
	_sp_frames += delta * FPS
	var data := _swing
	var startup := float(data.startup_frames)
	var player := _target()
	match _sp_phase:
		0:
			_move_horizontal(Vector3.ZERO, 0.0)
			if player != null and _sp_frames < startup * AIM_LOCK:
				_aim_dir = _flat_to(player).normalized()
				_locked_target = player.global_position
				_face(_aim_dir, delta)
			_show_telegraph(_sp_frames / startup)
			if _sp_frames >= startup:
				_begin_strike(player)
		1:
			_run_strike(delta, player)
		2:
			_move_horizontal(Vector3.ZERO, 0.0)
			_sp_timer -= delta
			if _sp_timer <= 0.0:
				_finish_attack(_gap())


func _gap() -> float:
	var scale := 1.0 - 0.22 * float(phase - 1)  # shorter gaps in later phases, never below the recovery window
	return maxf(randf_range(cooldown_min, cooldown_max) * scale, 0.5)


func _begin_strike(player: Player) -> void:
	_hide_telegraph()
	_sp_phase = 1
	_sp_timer = 0.0
	match _kind:
		&"volley":
			stats["volleys"] += 1
		&"sweep":
			stats["sweeps"] += 1
		&"barrage":
			stats["barrages"] += 1
		&"dash":
			stats["dashes"] += 1
			_dash_dir = _aim_dir if _aim_dir.length_squared() > 0.01 else Vector3.FORWARD
			_dash_start = global_position
			if player != null:
				add_collision_exception_with(player)  # run through the body: damage is a radius check
		&"ring":
			stats["rings"] += 1
			_spawn_ring(true)


func _run_strike(delta: float, player: Player) -> void:
	match _kind:
		&"volley":
			_shot_clock -= delta
			if _fired < _burst_for(&"volley") and _shot_clock <= 0.0:
				_fire_shot(_aim_dir, _swing)
				_fired += 1
				_shot_clock = SHOT_SPACING
			if _fired >= _burst_for(&"volley"):
				_enter_recovery()
		&"sweep":
			_sp_timer += delta
			var target_shots := int(clampf(_sp_timer / SWEEP_TIME, 0.0, 1.0) * SWEEP_SHOTS) + 1
			while _fired < mini(target_shots, SWEEP_SHOTS):
				var t := float(_fired) / float(SWEEP_SHOTS - 1)
				_fire_shot(_aim_dir.rotated(Vector3.UP, deg_to_rad(lerpf(-SWEEP_ARC * 0.5, SWEEP_ARC * 0.5, t))), _swing)
				_fired += 1
			if _fired >= SWEEP_SHOTS:
				_enter_recovery()
		&"barrage":
			_shot_clock -= delta
			if _fired < BARRAGE_PER_WAVE * 2 and _shot_clock <= 0.0:
				var wave := _fired / BARRAGE_PER_WAVE
				var i := _fired % BARRAGE_PER_WAVE
				var spread := lerpf(-12.0, 12.0, float(i) / float(BARRAGE_PER_WAVE - 1))
				var cross := deg_to_rad((-26.0 if wave == 0 else 26.0) + spread)
				_fire_shot(_aim_dir.rotated(Vector3.UP, cross), _swing)
				_fired += 1
				_shot_clock = 0.12 if i < BARRAGE_PER_WAVE - 1 else 0.5
			if _fired >= BARRAGE_PER_WAVE * 2:
				_enter_recovery()
		&"dash":
			_dash(delta, player)
		&"ring":
			_sp_timer += delta
			if _sp_timer >= RING_TIME + 0.15:
				_enter_recovery()


func _burst_for(kind: StringName) -> int:
	return 3 if kind == &"volley" else 1


func _enter_recovery() -> void:
	_sp_phase = 2
	_sp_timer = _swing.recovery_frames / float(FPS)
	_move_horizontal(Vector3.ZERO, 0.0)


func _finish_attack(cooldown: float) -> void:
	if _kind == &"dash":
		var player := _target()
		if player != null:
			remove_collision_exception_with(player)
	var combo := phase >= 2 and profile == PROFILE_DIRECTOR and _kind == &"volley" and not _transitioning
	_kind = &""
	_hide_telegraph()
	if combo:
		_planned = &"dash"  # volley then dash: the volley's recovery is the opening between the two
		cooldown = 0.0
	super(cooldown)


func _fire_shot(direction: Vector3, data: AttackData) -> void:
	var origin := global_position + Vector3(0.0, 1.3 * body_scale * 0.8, 0.0) + direction * 0.9
	var p := Projectile.fire(get_parent(), origin, direction, data, self, SHOT_SPEED, damage_mult)
	if p == null:
		projectile_cap_hits += 1
		return
	stats["shots"] += 1
	_shots.append(p)


func _dash(delta: float, player: Player) -> void:
	var moved := global_position.distance_to(_dash_start)
	var blocked := _wall_distance(_dash_dir, 1.0) < 0.9
	if moved >= DASH_MAX or blocked:
		_move_horizontal(Vector3.ZERO, 0.0)
		_enter_recovery()
		return
	_move_horizontal(_dash_dir, DASH_SPEED)
	if player != null and not _special_hit_done:
		var flat := Vector2(player.global_position.x - global_position.x, player.global_position.z - global_position.z)
		if flat.length() <= DASH_HIT_RADIUS:
			_special_hit_done = true
			player.receive_hit(_swing, global_position, damage_mult)


func _wall_distance(dir: Vector3, max_dist: float) -> float:
	var from := global_position + Vector3(0.0, 0.8, 0.0)
	var query := PhysicsRayQueryParameters3D.create(from, from + dir * max_dist, 1)
	query.collide_with_areas = false
	query.exclude = [get_rid()]
	var hit := get_world_3d().direct_space_state.intersect_ray(query)
	return max_dist if hit.is_empty() else from.distance_to(hit["position"])


# --- rings ----------------------------------------------------------------

static var _ring_mesh: CylinderMesh
static var _ring_material: StandardMaterial3D


static func ring_resources() -> Array:
	if _ring_mesh == null:
		_ring_mesh = CylinderMesh.new()
		_ring_mesh.top_radius = 1.0
		_ring_mesh.bottom_radius = 1.0
		_ring_mesh.height = 0.15
		_ring_material = StandardMaterial3D.new()
		_ring_material.albedo_color = Color(0.9, 0.15, 0.1, 0.45)
		_ring_material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		_ring_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	return [_ring_mesh, _ring_material]


func _ring_radius() -> float:
	return RING_RADIUS if profile == PROFILE_DIRECTOR else CAPTAIN_SLAM_RADIUS


func _spawn_ring(harmful: bool) -> void:
	var node := MeshInstance3D.new()
	var res := Director.ring_resources()
	node.mesh = res[0]
	node.material_override = res[1]
	node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	node.top_level = true
	add_child(node)
	node.global_position = Vector3(global_position.x, 0.1, global_position.z)
	node.scale = Vector3(0.01, 1.0, 0.01)
	_rings.append({"node": node, "age": 0.0, "hit": not harmful, "origin": node.global_position,
			"attack": _swing if harmful else null})


func _update_rings(delta: float) -> void:
	for i in range(_rings.size() - 1, -1, -1):
		var ring := _rings[i]
		var node := ring["node"] as MeshInstance3D
		ring["age"] = (ring["age"] as float) + delta
		var age := ring["age"] as float
		var radius := _ring_radius() * clampf(age / RING_TIME, 0.0, 1.0)
		if age >= RING_TIME + 0.1:
			node.queue_free()
			_rings.remove_at(i)
			continue
		node.scale = Vector3(maxf(radius, 0.01), 1.0, maxf(radius, 0.01))
		if ring["hit"] or age > RING_TIME:
			continue
		var player := _target()
		if player == null or not player.is_on_floor():
			continue  # jumping over the ring is the intended counter
		var origin := ring["origin"] as Vector3
		var flat := Vector2(player.global_position.x - origin.x, player.global_position.z - origin.z)
		if absf(flat.length() - radius) <= RING_BAND:
			ring["hit"] = player.receive_hit(ring["attack"] as AttackData, origin, damage_mult)


func clear_hazards() -> void:
	for ring in _rings:
		var node := ring["node"] as Node
		if is_instance_valid(node):
			node.queue_free()
	_rings.clear()
	for p in _shots:
		if is_instance_valid(p):
			p.deactivate()
	_shots.clear()
	_hide_telegraph()


# --- telegraph marker -------------------------------------------------------

func _show_telegraph(t: float) -> void:
	if _marker == null:
		_marker = MeshInstance3D.new()
		_marker.top_level = true
		_marker.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		var mat := StandardMaterial3D.new()
		mat.albedo_color = Color(1.0, 0.2, 0.1, 0.4)
		mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		_marker.material_override = mat
		add_child(_marker)
	_marker.visible = true
	var origin := Vector3(global_position.x, 0.12, global_position.z)
	if _kind == &"ring":
		_marker.mesh = Director.ring_resources()[0]
		_marker.global_transform = Transform3D(Basis.IDENTITY.scaled(Vector3.ONE * _ring_radius() * clampf(t, 0.1, 1.0)), origin)
		return
	var length := 14.0
	var box := BoxMesh.new()
	box.size = Vector3(0.4 if _kind != &"dash" else 1.2, 0.05, length)
	_marker.mesh = box
	var dir := _aim_dir if _aim_dir.length_squared() > 0.01 else Vector3.FORWARD
	_marker.global_transform = Transform3D(Basis.looking_at(dir, Vector3.UP), origin + dir * length * 0.5)


func _hide_telegraph() -> void:
	if _marker != null:
		_marker.visible = false


# --- hits, phases ----------------------------------------------------------

func receive_hit(attack: AttackData, from_position: Vector3, damage_scale: float = 1.0) -> bool:
	if _transitioning:
		return false  # invulnerable while he changes phase
	return super(attack, from_position, damage_scale)


func _hit_interrupts(attack: AttackData) -> bool:
	return attack.stagger_time >= INTERRUPT_STAGGER


func _on_damaged() -> void:
	if profile != PROFILE_DIRECTOR or _transitioning:
		return
	if _target_phase() > phase:
		_begin_phase(phase + 1)


func _target_phase() -> int:
	var fraction := _health.health / _health.max_health
	if fraction <= PHASE3_THRESHOLD:
		return 3
	if fraction <= PHASE2_THRESHOLD:
		return 2
	return 1


func _begin_phase(next: int) -> void:
	phase = next
	stats["phase_changes"] += 1
	_transitioning = true
	_transition_time = TRANSITION_TIME
	_hitbox.deactivate()
	_weapon_pivot.visible = false
	_release_token()
	_kind = &""
	_planned = &""
	_sp_phase = 0
	clear_hazards()
	remove_collision_exceptions_with_player()
	_spawn_ring(false)
	body_color = PHASE_COLORS[clampi(phase - 1, 0, 2)]
	state = State.STAGGER
	_stagger_time = TRANSITION_TIME
	var line: String = LINES.get(phase, "")
	if line != "":
		Outpost17.say(self, line, 3.5)
	phase_changed.emit(phase)


func remove_collision_exceptions_with_player() -> void:
	var player := _target()
	if player != null:
		remove_collision_exception_with(player)


func _state_stagger(delta: float) -> void:
	if _transitioning:
		_stagger_time = maxf(_stagger_time, _transition_time)  # a hit cannot cut the transition short
	super(delta)


func _update_transition(delta: float) -> void:
	var before := _transition_time
	_transition_time -= delta
	if before > TRANSITION_TIME * 0.5 and _transition_time <= TRANSITION_TIME * 0.5:
		_spawn_ring(false)  # a second harmless pulse mid-transition
	if _transition_time <= 0.0:
		_transitioning = false
		_cooldown = GRACE_AFTER_TRANSITION
		if state == State.STAGGER:
			state = State.CHASE
		if _target_phase() > phase:
			_begin_phase(phase + 1)  # a huge hit skipped a phase: play the next transition too


# --- loot and defeat ---------------------------------------------------------

func _drop_loot() -> void:
	var table := load(loot_table_path) as LootTable
	if table == null:
		return
	var player := get_tree().get_first_node_in_group("player") as Player
	var claimed: Dictionary = player.inventory.unique_claimed if player != null else {}
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var entries := table.roll_all(rng, claimed)
	for i in entries.size():
		var item := entries[i]["item"] as ItemData
		var angle := TAU * i / maxi(entries.size(), 1)
		var spot := Vector3(global_position.x + cos(angle) * 2.2, 0.0, global_position.z + sin(angle) * 2.2)
		Pickup.spawn.call_deferred(get_parent(), item, spot)


func _die() -> void:
	if _defeat_done:
		return
	_defeat_done = true
	_kind = &""
	_planned = &""
	_transitioning = false
	clear_hazards()
	super()
	var world := get_node_or_null("/root/WorldState")
	var flag := DEFEATED_FLAG if profile == PROFILE_DIRECTOR else CAPTAIN_FLAG
	if world != null and not world.has_flag(flag):
		world.set_flag(flag, true)
		if profile == PROFILE_DIRECTOR:
			defeated_director.emit()
			Outpost17.say(self, DEFEAT_LINE, 4.0)
	HitStop.trigger(SLOWMO_SECONDS)
